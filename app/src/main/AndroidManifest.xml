<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core Messaging Permissions (Requested Just-in-Time as needed) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".AetherApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>



        <receiver
            android:name=".data.notifications.NotificationActionReceiver"
            android:exported="false" />

        <!--
          Bound by the FCM SDK, not a foreground service: it runs briefly to
          hand a push to TDLib (see AetherFirebaseMessagingService) and is not
          a persistent "Aether is running" notification. Registering it does
          not require FOREGROUND_SERVICE or any related permission.
        -->
        <service
            android:name=".data.push.AetherFirebaseMessagingService"
            android:enabled="${aetherFcmEnabled}"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Firebase remains on the compile/runtime classpath so the configured
          FCM build uses the same source set. Without google-services.json,
          every Firebase process entry point is disabled before Application
          startup; BuildConfig checks alone run too late for ContentProviders.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:enabled="${aetherFcmEnabled}" />

        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            android:enabled="${aetherFcmEnabled}" />

        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:enabled="${aetherFcmEnabled}" />

        <service
            android:name="com.google.firebase.components.ComponentDiscoveryService"
            android:enabled="${aetherFcmEnabled}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
