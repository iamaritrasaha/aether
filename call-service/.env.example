# Development Aether Call Service configuration. Copy to .env, fill in, and
# `set -a; source .env; set +a` before `npm start` (or use run-dev.sh).
# NEVER commit the real .env. The LiveKit API secret never leaves this machine.

# What the Android app connects to (the app's BuildConfig.AETHER_CALL_SERVICE_URL
# is the HTTP URL of THIS service; LIVEKIT_URL is the signaling WebSocket).
PORT=8080
LIVEKIT_URL=ws://192.168.0.30:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-livekit-server-generate-keys-output
