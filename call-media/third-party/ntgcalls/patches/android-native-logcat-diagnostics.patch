 namespace ntgcalls::utils {
     webrtc::scoped_refptr<LogSink> LogSink::instance_ = nullptr;
@@ -83,6 +86,20 @@ namespace ntgcalls::utils {
     }
 
     void LogSink::OnLogMessage(const std::string& message, const webrtc::LoggingSeverity severity) {
+#ifdef __ANDROID__
+        // The Android bindings register no log-message callback, so without
+        // this bridge every WebRTC/ntgcalls log line was swallowed (stderr is
+        // disabled and on_log_message_ is null): ICE/DTLS/SRTP diagnostics
+        // were invisible on physical devices. Emit to logcat under a stable
+        // tag; severity INFO and above only (LogToDebug(LS_INFO) in release).
+        android_LogPriority priority = ANDROID_LOG_INFO;
+        if (severity == webrtc::LS_ERROR) {
+            priority = ANDROID_LOG_ERROR;
+        } else if (severity == webrtc::LS_WARNING) {
+            priority = ANDROID_LOG_WARN;
+        }
+        __android_log_print(priority, "AetherCallNative", "%s", message.c_str());
+#endif
         register_log_message(message, severity);
     }
 
