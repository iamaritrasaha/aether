#!/usr/bin/env bash
# Summarize a captured Aether call-diagnostics log: connection timeline,
# capture/playback progression, RTP counters, reconnects, errors.
#
# Usage: tools/call-diagnostics-summary diagnostics/call-diagnostics-XXXX.log

set -euo pipefail
LOG="${1:-}"
if [ -z "$LOG" ] || [ ! -f "$LOG" ]; then
    echo "usage: $0 <captured-diagnostics-log>" >&2
    exit 1
fi

echo "=== Call diagnostics summary: $LOG ==="
echo ""
echo "-- Connection / stage timeline (gen, stage, detail) --"
grep -E "AetherCall" "$LOG" | grep -oE "gen=[0-9]+ stage=[A-Z_]+.*" | sed 's/signal=.*//' | awk '!seen[$0]++ || /CONNECTED|FAILED|TIMEOUT|STOPPED|TEARDOWN/' | head -40 || true

echo ""
echo "-- Native connection state transitions --"
grep -oE "native state=[A-Z]+ kind=[a-z]+ mapped=[A-Z_]+" "$LOG" | uniq -c || echo "  (none)"

echo ""
echo "-- Capture / playback media time (last 6 samples per counter) --"
grep -oE "media_activity callId=[0-9]+ capture=[0-9]+s(\(\+[0-9]+s\)|\(new\)) playback=[0-9]+s(\(\+[0-9]+s\)|\(new\))" "$LOG" | tail -6 || echo "  (no media_activity samples)"

echo ""
echo "-- RTP counters (outgoing / incoming, last of each) --"
grep -oE "outgoing RTP count=[0-9]+ size=[0-9-]+" "$LOG" | tail -1 || true
grep -oE "incoming RTP ok=[0-9]+ decrypt_fail=[0-9]+" "$LOG" | tail -1 || true
echo "outgoing-RTP lines: $(grep -c 'outgoing RTP count' "$LOG" || true)"
echo "incoming-RTP lines: $(grep -c 'incoming RTP ok' "$LOG" || true)"

echo ""
echo "-- Remote source events --"
grep -oE "remote_source ssrc=[0-9]+ state=[A-Z]+ device=[A-Z]+" "$LOG" | uniq -c || echo "  (none)"

echo ""
echo "-- Stream end events --"
grep -oE "stream_end type=[A-Z]+ device=[A-Z]+" "$LOG" | head -5 || echo "  (none)"

echo ""
echo "-- Audio routing --"
grep -oE "audio_hw mode=[0-9]+ commDeviceType=[0-9-]+ micMute=[a-z]+" "$LOG" | tail -2 || true
grep -oE "route_request requested=[A-Z]+ applied=[a-z]+ deviceType=[0-9-]+" "$LOG" | tail -2 || true
grep -oE "route_changed reason=[a-z_]+ route=[A-Z]+" "$LOG" | tail -3 || true

echo ""
echo "-- Failures (sanitised) --"
grep -oE "at=[A-Z_]+ type=[^ ]+ msg=.*" "$LOG" | head -8 || echo "  (none)"

echo ""
echo "-- WebRTC/native warnings+errors (AetherCallNative, deduped) --"
grep "AetherCallNative" "$LOG" | grep -E " W | E " | sed 's/^[0-9:. -]*//; s/[0-9]+//g' | sort -u | head -12 || echo "  (none)"

echo ""
echo "-- ICE/DTLS hints from WebRTC logs --"
grep -iE "AetherCallNative.*(ice|dtls|srtp|writable)" "$LOG" | sed 's/^[0-9:. -]*//' | sort -u | head -10 || echo "  (none)"

echo ""
echo "-- Approximate connected duration per generation (first CONNECTED -> teardown) --"
python3 - "$LOG" <<-'PYEOF' || true
import re, sys
lines = [l for l in open(sys.argv[1], errors="replace") if "AetherCall" in l]
stamp = re.compile(r"(\d{2}):(\d{2}):(\d{2})\.(\d+)")
gen = re.compile(r"gen=(\d+)")
def seconds(l):
    m = stamp.match(l)
    if not m: return None
    h, mi, s, ms = m.groups()
    return int(h)*3600 + int(mi)*60 + int(s) + int(ms)/1000.0
first_connected, last_event, gens = {}, {}, set()
for l in lines:
    g = gen.search(l)
    if not g: continue
    g = int(g.group(1)); gens.add(g)
    t = seconds(l)
    if t is None: continue
    if "stage=MEDIA_CONNECTED" in l or "media=CONNECTED" in l:
        first_connected.setdefault(g, t)
    if "stage=TEARDOWN" in l or "stage=SERVICE_STOPPED" in l or "stage=FAILED" in l:
        last_event[g] = t
for g in sorted(gens):
    a, b = first_connected.get(g), last_event.get(g)
    if a is not None:
        dur = f"{(b-a):.1f}s" if b is not None and b >= a else "open-ended in log"
        print(f"  gen={g}: connected ~{dur} (from {a:.0f}s)")
    else:
        print(f"  gen={g}: never reached MEDIA_CONNECTED")
PYEOF

echo ""
echo "-- A-F flow classification evidence --"
CAP_GROWTH=$(grep -cE "capture=[0-9]+s\(\+[0-9]+s\)" "$LOG" || true)
PBK_GROWTH=$(grep -cE "playback=[0-9]+s\(\+[0-9]+s\)" "$LOG" || true)
OUT_RTP=$(grep -oE "outgoing RTP count=[0-9]+" "$LOG" | tail -1 | grep -oE "[0-9]+" || echo 0)
IN_RTP=$(grep -oE "incoming RTP ok=[0-9]+" "$LOG" | tail -1 | grep -oE "[0-9]+" || echo 0)
echo "  capture growth samples: $CAP_GROWTH | playback growth samples: $PBK_GROWTH"
echo "  last outgoing RTP: $OUT_RTP | last incoming RTP ok: $IN_RTP"
if [ "$CAP_GROWTH" -gt 0 ] && [ "$PBK_GROWTH" -gt 0 ] && [ "$OUT_RTP" -gt 0 ] && [ "$IN_RTP" -gt 0 ]; then
    echo "  => A: all counters advance; pipeline alive. Silence reported = routing (E)."
elif [ "$CAP_GROWTH" -gt 0 ] && [ "$OUT_RTP" = "0" ]; then
    echo "  => B: capture advances, outgoing RTP 0 -- send path."
elif [ "$OUT_RTP" -gt 0 ] && [ "$IN_RTP" = "0" ]; then
    echo "  => C: outgoing RTP advances, incoming 0 -- negotiation/receive/crypto."
elif [ "$IN_RTP" -gt 0 ] && [ "$PBK_GROWTH" = "0" ]; then
    echo "  => D: incoming RTP advances, playback 0 -- decoder/playback path."
elif [ "$PBK_GROWTH" -gt 0 ] && [ "$CAP_GROWTH" = "0" ]; then
    echo "  => F: capture 0 -- mic path."
else
    echo "  => insufficient evidence for a single class; correlate sections above."
fi

echo ""
echo "=== end summary ==="
